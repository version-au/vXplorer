<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>vXplorer</AssemblyName>
    <RootNamespace>vXplorer</RootNamespace>
    <StartupObject>vXplorer.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- made by running vXplorer.exe with make-icon (the drawing is src\Ui\Brand.cs), in vShell's default colours; the window's icon follows the theme -->
    <ApplicationIcon>vxplorer.ico</ApplicationIcon>
    <Version>0.1.56</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- the Windows Shell: icons and thumbnails, the native right-click menu, Explorer-style file operations -->
    <PackageReference Include="Vanara.Windows.Shell" Version="5.0.8" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.4" />
  </ItemGroup>

  <!-- the tests (tests\vXplorer.Tests) are their own project: dotnet test tests\vXplorer.Tests -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <None Remove="tests\**" />
    <InternalsVisibleTo Include="vXplorer.Tests" />
  </ItemGroup>

  <!-- the suite's shared library (git submodule vSuite.Core): theme, glass, styles, questions, log, updater, Options blocks, shell icons -->
  <ItemGroup>
    <ProjectReference Include="vSuite.Core\vSuite.Core\vSuite.Core.csproj" />
    <ProjectReference Include="vSuite.Core\vSuite.Shell\vSuite.Shell.csproj" />
    <Compile Remove="vSuite.Core\**" />
    <Page Remove="vSuite.Core\**" />
    <None Remove="vSuite.Core\**" />
    <EmbeddedResource Remove="vSuite.Core\**" />
    <Resource Remove="vSuite.Core\**" />
  </ItemGroup>

</Project>
