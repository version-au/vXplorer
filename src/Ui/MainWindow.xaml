<Window x:Class="vXplorer.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vXplorer" Width="1100" Height="700" MinWidth="560" MinHeight="340"
        FontFamily="Segoe UI" FontSize="12.5" Foreground="{DynamicResource vx.Fg}" Background="Transparent"
        UseLayoutRounding="True">

    <Window.Resources>
        <system:Double x:Key="vx.TileIcon" xmlns:system="clr-namespace:System;assembly=System.Runtime">96</system:Double>

        <!-- a tile in the icon views: the thumbnail over the name (two lines at most) -->
        <Style x:Key="vx.TileItem" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="Loaded" Handler="Tile_Loaded"/>
            <EventSetter Event="Unloaded" Handler="Tile_Unloaded"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource vx.ItemRadius}" Margin="3" Padding="6,8,6,6">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Width="{DynamicResource vx.TileIcon}" Height="{DynamicResource vx.TileIcon}" HorizontalAlignment="Center">
                                    <Image x:Name="Fallback" Source="{Binding Icon}" Width="32" Height="32"/>
                                    <Image Source="{Binding Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock x:Name="NameText" Text="{Binding DisplayName}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               TextAlignment="Center" MaxHeight="40" FontSize="{DynamicResource vx.ListFont}" VerticalAlignment="Top"/>
                                    <TextBox x:Name="RenameBox" Style="{StaticResource vx.RenameBox}" Margin="0" TextWrapping="Wrap" TextAlignment="Center"
                                             VerticalAlignment="Top" Visibility="Collapsed"
                                             PreviewKeyDown="RenameBox_PreviewKeyDown" LostKeyboardFocus="RenameBox_LostKeyboardFocus"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource vx.Hover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource vx.Selected}"/></Trigger>
                            <DataTrigger Binding="{Binding HasThumb}" Value="True"><Setter TargetName="Fallback" Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsCut}" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource vx.Active}"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                <Setter TargetName="RenameBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="NameText" Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- text and code in the preview pane -->
        <Style x:Key="vx.PreviewText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource vx.Accent}"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource vx.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ===== Tab strip: tabs, a new-tab button, then free title bar to grab (the whole top drags the window) ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- vXplorer's icon (a folder with the vShell mark), drawn in the theme's colours -->
            <!-- vXplorer's icon: its menu (New tab, New window, Options, About, Close) -->
            <Button x:Name="AppMenuBtn" Style="{StaticResource vx.IconButton}" Width="34" Height="30" Margin="6,2,4,0" VerticalAlignment="Center"
                    ToolTip="vXplorer menu" Click="AppMenu_Click">
                <Image x:Name="AppMark" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <!-- the tabs: vSuite's TabStrip (MainWindow.Tabs.cs puts it here) - arrows when they don't fit, dragging, tearing out -->
            <Border x:Name="TabArea" Grid.Column="1" VerticalAlignment="Bottom"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource vx.CaptionButton}" Content="&#xE921;" ToolTip="Minimise" Click="Minimize_Click"/>
                <Button x:Name="MaxBtn" Style="{StaticResource vx.CaptionButton}" Content="&#xE922;" ToolTip="Maximise" Click="Maximize_Click"/>
                <Button Style="{StaticResource vx.CloseButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===== Toolbar: navigation and the address bar (gaps between them drag the window too) ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                <!-- search: the open folder and everything under it, by name -->
                <Border x:Name="SearchCard" Style="{StaticResource vx.Card}" Height="32" Width="240" Margin="0,0,8,0" Cursor="IBeam"
                        WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonDown="SearchCard_MouseLeftButtonDown">
                    <Grid Margin="10,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SearchGlyph" Text="&#xE721;" FontFamily="{StaticResource vx.Icons}" FontSize="12" Foreground="{DynamicResource vx.FgDim}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="SearchHint" Grid.Column="1" Foreground="{DynamicResource vx.FgDim}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource vx.AddressBox}" VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        <Button x:Name="SearchClear" Grid.Column="2" Style="{StaticResource vx.TabClose}" Content="&#xE8BB;" ToolTip="Clear the search (Esc)"
                                Click="SearchClear_Click" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <Button x:Name="PreviewBtn" Style="{StaticResource vx.IconButton}" Content="&#xE8A1;" ToolTip="Preview pane (Alt+P)" Click="PreviewButton_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button x:Name="BackBtn" Style="{StaticResource vx.IconButton}" Content="&#xE72B;" ToolTip="Back (Alt+Left)" Click="Back_Click"/>
                <Button x:Name="ForwardBtn" Style="{StaticResource vx.IconButton}" Content="&#xE72A;" ToolTip="Forward (Alt+Right)" Click="Forward_Click"/>
                <Button x:Name="UpBtn" Style="{StaticResource vx.IconButton}" Content="&#xE74A;" ToolTip="Up a folder (Alt+Up)" Click="Up_Click"/>
                <Button Style="{StaticResource vx.IconButton}" Content="&#xE72C;" ToolTip="Refresh (F5)" Click="Refresh_Click"/>
            </StackPanel>

            <Border x:Name="AddressCard" Grid.Column="1" Style="{StaticResource vx.Card}" Height="32" Margin="8,0,8,0" Cursor="IBeam"
                    WindowChrome.IsHitTestVisibleInChrome="True" PreviewMouseLeftButtonDown="AddressCard_MouseLeftButtonDown">
                <Grid>
                    <!-- the space at the end is always there to click in, even when the crumbs fill the bar -->
                    <ScrollViewer x:Name="CrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="3,0,48,0">
                        <StackPanel x:Name="Crumbs" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ScrollViewer>
                    <TextBox x:Name="AddressBox" Style="{StaticResource vx.AddressBox}" Visibility="Collapsed" Margin="8,0" VerticalAlignment="Center"
                             KeyDown="AddressBox_KeyDown" LostKeyboardFocus="AddressBox_LostKeyboardFocus"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Sidebar and file list (with the command bar over the list) ===== -->
        <Grid x:Name="ContentGrid" Grid.Row="2" Margin="8,4,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideCol" Width="230" MinWidth="140" MaxWidth="500"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition x:Name="PreviewCol" Width="0" MaxWidth="900"/>
            </Grid.ColumnDefinitions>

        <!-- Command bar: New, Cut, Copy, Paste, Rename, Delete, Sort, View (like Explorer's and Files'), above the files only -->
        <StackPanel x:Name="CommandBar" Grid.Column="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="2,0,0,2" Height="38">
            <Button x:Name="CmdNew" Style="{StaticResource vx.CommandButton}" ToolTip="Make a new folder or file here" Click="CmdNew_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource vx.CommandGlyph}"/>
                    <TextBlock Text="New" Margin="8,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource vx.Icons}" FontSize="8" VerticalAlignment="Center" Foreground="{DynamicResource vx.FgDim}"/>
                </StackPanel>
            </Button>
            <Rectangle Style="{StaticResource vx.CommandSeparator}"/>
            <Button x:Name="CmdCut" Style="{StaticResource vx.IconButton}" Width="36" Height="32" Content="&#xE8C6;" ToolTip="Cut (Ctrl+X)" Click="CmdCut_Click"/>
            <Button x:Name="CmdCopy" Style="{StaticResource vx.IconButton}" Width="36" Height="32" Content="&#xE8C8;" ToolTip="Copy (Ctrl+C)" Click="CmdCopy_Click"/>
            <Button x:Name="CmdPaste" Style="{StaticResource vx.IconButton}" Width="36" Height="32" Content="&#xE77F;" ToolTip="Paste (Ctrl+V)" Click="CmdPaste_Click"/>
            <Button x:Name="CmdRename" Style="{StaticResource vx.IconButton}" Width="36" Height="32" Content="&#xE8AC;" ToolTip="Rename (F2)" Click="CmdRename_Click"/>
            <Button x:Name="CmdDelete" Style="{StaticResource vx.IconButton}" Width="36" Height="32" Content="&#xE74D;" ToolTip="Delete (Delete) - Shift+click deletes for good" Click="CmdDelete_Click"/>
            <!-- zips: shown only when they apply -->
            <Button x:Name="CmdExtract" Style="{StaticResource vx.CommandButton}" ToolTip="Extract everything in the zip into a folder next to it" Click="CmdExtract_Click" Visibility="Collapsed" Margin="4,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" Style="{StaticResource vx.CommandGlyph}"/>
                    <TextBlock Text="Extract all" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="CmdCompress" Style="{StaticResource vx.IconButton}" Width="36" Height="32" Content="&#xF012;" ToolTip="Compress to ZIP file" Click="CmdCompress_Click" Visibility="Collapsed"/>
            <Rectangle Style="{StaticResource vx.CommandSeparator}"/>
            <Button x:Name="CmdSort" Style="{StaticResource vx.CommandButton}" ToolTip="Sort the files" Click="CmdSort_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8CB;" Style="{StaticResource vx.CommandGlyph}"/>
                    <TextBlock Text="Sort" Margin="8,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource vx.Icons}" FontSize="8" VerticalAlignment="Center" Foreground="{DynamicResource vx.FgDim}"/>
                </StackPanel>
            </Button>
            <Button x:Name="ViewBtn" Style="{StaticResource vx.CommandButton}" ToolTip="View (Ctrl+Shift+1, 2, 3, 6)" Click="ViewButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A9;" Style="{StaticResource vx.CommandGlyph}"/>
                    <TextBlock Text="View" Margin="8,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource vx.Icons}" FontSize="8" VerticalAlignment="Center" Foreground="{DynamicResource vx.FgDim}"/>
                </StackPanel>
            </Button>
        </StackPanel>

            <Border Grid.RowSpan="3" Style="{StaticResource vx.Card}" Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Quick access" Style="{StaticResource vx.SectionHeader}"/>
                        <TreeView x:Name="QuickTree" SelectedItemChanged="Tree_SelectedItemChanged" PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp"
                                  AllowDrop="True" DragOver="Tree_DragOver" Drop="Tree_Drop" DragLeave="Drop_DragLeave" MouseRightButtonUp="Tree_MouseRightButtonUp"/>
                        <!-- "This PC" opens the drives page, like Explorer's This PC: a row like the tree's, with the drives under it -->
                        <Border x:Name="ThisPcRow" CornerRadius="{DynamicResource vx.ItemRadius}" Padding="2,4" Margin="0,10,0,1" ToolTip="Open This PC"
                                MouseLeftButtonUp="ThisPcHeader_Click" MouseRightButtonUp="ThisPcRow_MouseRightButtonUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource vx.Hover}"/></Trigger>
                                        <Trigger Property="Tag" Value="open"><Setter Property="Background" Value="{DynamicResource vx.Selected}"/></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Width="16" Text="&#xE70D;" FontFamily="{StaticResource vx.Icons}" FontSize="8"
                                           Foreground="{DynamicResource vx.FgDim}" TextAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="ThisPcIcon" DockPanel.Dock="Left" Width="16" Height="16" Margin="2,0,7,0"/>
                                <TextBlock Text="This PC" Foreground="{DynamicResource vx.Fg}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <TreeView x:Name="DriveTree" Margin="14,0,0,0" SelectedItemChanged="Tree_SelectedItemChanged" PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp"
                                  AllowDrop="True" DragOver="Tree_DragOver" Drop="Tree_Drop" DragLeave="Drop_DragLeave" MouseRightButtonUp="Tree_MouseRightButtonUp"/>
                        <!-- Network: computers (found only when it's opened), each with its shared folders -->
                        <TreeView x:Name="NetTree" Margin="0,10,0,0" SelectedItemChanged="Tree_SelectedItemChanged" PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp"
                                  AllowDrop="True" DragOver="Tree_DragOver" Drop="Tree_Drop" DragLeave="Drop_DragLeave" MouseRightButtonUp="Tree_MouseRightButtonUp"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Grid.RowSpan="3" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource vx.Card}" Padding="6,4,4,4">
                <Grid>
                    <ListView x:Name="Files" SelectionMode="Extended" VirtualizingPanel.IsVirtualizingWhenGrouping="True" TextSearch.TextPath="DisplayName" IsTextSearchEnabled="True" FontSize="{DynamicResource vx.ListFont}" PreviewMouseWheel="Files_PreviewMouseWheel"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                              MouseDoubleClick="Files_MouseDoubleClick" KeyDown="Files_KeyDown" SelectionChanged="Files_SelectionChanged"
                              PreviewMouseRightButtonDown="Files_PreviewMouseRightButtonDown" MouseRightButtonUp="Files_MouseRightButtonUp"
                              PreviewMouseLeftButtonDown="Files_PreviewMouseLeftButtonDown" PreviewMouseMove="Files_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="Files_PreviewMouseLeftButtonUp" LostMouseCapture="Files_LostMouseCapture"
                              AllowDrop="True" DragOver="Files_DragOver" Drop="Files_Drop" DragLeave="Drop_DragLeave"
                              GridViewColumnHeader.Click="Header_Click">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="340">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                                                <Grid>
                                                    <TextBlock x:Name="NameText" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="RenameBox" Style="{StaticResource vx.RenameBox}" Visibility="Collapsed"
                                                             PreviewKeyDown="RenameBox_PreviewKeyDown" LostKeyboardFocus="RenameBox_LostKeyboardFocus"/>
                                                </Grid>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                    <Setter TargetName="RenameBox" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="NameText" Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Date modified" Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource vx.FgDim}"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Type" Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding TypeName}" Foreground="{DynamicResource vx.FgDim}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Size" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource vx.FgDim}" HorizontalAlignment="Right" Margin="0,0,6,0"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                        <!-- Group by (Sort menu): a header over each group, like This PC's sections -->
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="4,10,6,4">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding ItemCount, StringFormat='  ({0})'}" Foreground="{DynamicResource vx.FgDim}"/>
                                            <Rectangle Height="1" Margin="10,1,0,0" VerticalAlignment="Center" Fill="{DynamicResource vx.Track}" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                    </ListView>
                    <TextBlock x:Name="EmptyText" Text="This folder is empty." Foreground="{DynamicResource vx.FgDim}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center"/>
                    <!-- This PC: drives and network locations as tiles with a used-space bar, like Explorer's -->
                    <ListBox x:Name="PcList" Visibility="Collapsed" TextSearch.TextPath="Name" IsTextSearchEnabled="True" Background="Transparent" BorderThickness="0" Padding="2,0,2,6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="False"
                             FocusVisualStyle="{x:Null}" SelectionMode="Single" AllowDrop="True"
                             MouseDoubleClick="PcList_MouseDoubleClick" KeyDown="PcList_KeyDown" SelectionChanged="PcList_SelectionChanged"
                             PreviewMouseLeftButtonDown="PcList_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="PcList_PreviewMouseRightButtonDown"
                             MouseRightButtonUp="PcList_MouseRightButtonUp"
                             DragOver="PcList_DragOver" Drop="PcList_Drop" DragLeave="Drop_DragLeave">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="6,12,6,6">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding ItemCount, StringFormat=' ({0})'}" Foreground="{DynamicResource vx.FgDim}" FontSize="13"/>
                                            <Border Height="1" Background="{DynamicResource vx.Track}" Margin="12,1,0,0" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <!-- the sections, one under the other -->
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <!-- the tiles in a section, wrapping -->
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
                                <Setter Property="ToolTip" Value="{Binding Path}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Width="290" Margin="3" Padding="10,8" Background="Transparent" CornerRadius="{DynamicResource vx.ItemRadius}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding Icon}" Width="48" Height="48" Margin="0,0,12,0" VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                        <Grid x:Name="Bar" Height="12" Margin="0,5,0,4" Visibility="Collapsed">
                                                            <Border Background="{DynamicResource vx.Track}" CornerRadius="2"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="{Binding UsedPart}"/>
                                                                    <ColumnDefinition Width="{Binding FreePart}"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border x:Name="Fill" Background="{DynamicResource vx.Accent}" CornerRadius="2"/>
                                                            </Grid>
                                                        </Grid>
                                                        <TextBlock Text="{Binding SpaceText}" Foreground="{DynamicResource vx.FgDim}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource vx.Hover}"/></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource vx.Selected}"/></Trigger>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource vx.Active}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding HasSpace}" Value="True"><Setter TargetName="Bar" Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding IsLow}" Value="True"><Setter TargetName="Fill" Property="Background" Value="{DynamicResource vx.Secondary}"/></DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <!-- the selection box (drag from an empty part of the list) -->
                    <Canvas x:Name="BandLayer" IsHitTestVisible="False" ClipToBounds="True">
                        <Rectangle x:Name="Band" Visibility="Collapsed" Fill="{DynamicResource vx.Selected}" Stroke="{DynamicResource vx.Accent}"
                                   StrokeThickness="1" Opacity="0.8" RadiusX="2" RadiusY="2"/>
                    </Canvas>
                </Grid>
            </Border>

            <GridSplitter x:Name="PreviewSplitter" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Visibility="Collapsed"/>

            <!-- ===== Preview pane ===== -->
            <Border x:Name="PreviewCard" Grid.Row="1" Grid.Column="4" Style="{StaticResource vx.Card}" Padding="14,12" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="PreviewStage">
                        <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                        <TextBox x:Name="PreviewText" Style="{StaticResource vx.PreviewText}" Visibility="Collapsed"/>
                        <!-- Windows' preview handler (PDF, Office, fonts, video …): a window of its own, shown over the thumbnail once it has loaded -->
                        <ui:PreviewHost x:Name="PreviewWin" Visibility="Hidden" xmlns:ui="clr-namespace:vXplorer.Ui"/>
                        <TextBlock x:Name="PreviewNote" Foreground="{DynamicResource vx.FgDim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock x:Name="PreviewName" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PreviewKind" Foreground="{DynamicResource vx.FgDim}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="PreviewProps" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="{Binding Key}" Width="84" Foreground="{DynamicResource vx.FgDim}" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Copies, moves and deletes (OpsPanel.cs): under the list and the preview ===== -->
            <ui:OpsPanel x:Name="OpsPanel" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" xmlns:ui="clr-namespace:vXplorer.Ui"/>
        </Grid>

        <!-- ===== Status ===== -->
        <DockPanel x:Name="StatusBar" Grid.Row="3" Margin="16,0">
            <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Foreground="{DynamicResource vx.FgDim}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource vx.FgDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
